# הגדרות מודל השפה - העתיקו לקובץ .env והכניסו מפתח
# ספק: gemini / openai
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.1-flash-lite
# מודלי גיבוי כשהראשי עמוס (מופרדים בפסיק)
LLM_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash

# Gemini (Google)
GOOGLE_API_KEY=
# מפתח גיבוי (אופציונלי) - עדיף מפרויקט Google נפרד, כי המכסה נספרת לכל פרויקט
GOOGLE_API_KEY_2=
GOOGLE_API_KEY_3=

# OpenAI (אופציונלי)
OPENAI_API_KEY=

# סיסמת כניסה למסך הנציג (חובה בענן; מקומית אפשר להשאיר ריק)
REP_PASSWORD=
