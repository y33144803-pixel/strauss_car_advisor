# הגדרות מודל השפה - העתיקו לקובץ .env והכניסו מפתח
# ספק: gemini / openai
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.1-flash-lite
# מודלי גיבוי כשהראשי עמוס (מופרדים בפסיק)
LLM_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash

# Gemini (Google)
GOOGLE_API_KEY=
# מפתח גיבוי (אופציונלי) - עדיף מפרויקט Google נפרד, כי המכסה נספרת לכל פרויקט
GOOGLE_API_KEY_2=
GOOGLE_API_KEY_3=

# OpenAI (אופציונלי)
OPENAI_API_KEY=

# משתמשים (חובה): שם_משתמש:סיסמה:תפקיד:שם_תצוגה, מופרדים ב-; (תפקיד: employee / rep).
# אסור להשתמש ב-: וב-; בתוך שם או סיסמה. סיסמה: לפחות 6 תווים.
AUTH_USERS=dana:CHANGE-ME-1:employee:דנה כהן;moshe:CHANGE-ME-2:rep:משה לוי
# בפיתוח מקומי בלבד אפשר לכבות את ההתחברות (AUTH_DISABLED=1). לעולם לא בענן.
# AUTH_DISABLED=1

# (אופציונלי, לדמו) מילוי מראש של שם המשתמש והסיסמה של עובד במסך הכניסה, לפי שם המשתמש ב-AUTH_USERS.
# הסיסמה נשלחת לדפדפן, ולכן כל מי שפותח את האתר נכנס כמשתמש הזה. רק עובד, לעולם לא נציג. כבו אחרי הדמו.
# LOGIN_PREFILL_USER=dana

